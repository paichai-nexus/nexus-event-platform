# Required. Choose exactly one of: mock, postgres-test, staging, production.
# The application fails closed when this is missing or invalid.
APP_RUNTIME_MODE=
ALLOW_MOCK_RUNTIME=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=http://localhost:3000
ATTENDANCE_EXIT_SECRET=

# Phase 7 hosted Staging validation. Keep all credentials empty in Git.
# Validation is blocked unless the URL-derived ref, configured ref, allowlist,
# and separately registered Production refs agree that the target is Staging.
ALLOW_STAGING_TESTS=false
STAGING_SUPABASE_PROJECT_REF=
STAGING_SUPABASE_PROJECT_REF_ALLOWLIST=
PRODUCTION_SUPABASE_PROJECT_REFS=
STAGING_APP_ORIGIN_ALLOWLIST=
PRODUCTION_APP_ORIGINS=
P0C_STAGING_DATABASE_URL=
P0C_STAGING_PSQL_PATH=psql
P0C_STAGING_EVENT_ID=
P0C_STAGING_ADMIN_COOKIE=
P0C_STAGING_STAFF_COOKIE=
P0C_STAGING_JUDGE_COOKIE=

# Isolated P0-B integration tests only. Never point this at staging or production.
ALLOW_POSTGRES_TEST_RUNTIME=false
P0B_POSTGRES_URL=
P0B_TEST_AUTH_SECRET=
P0B_PSQL_PATH=/opt/homebrew/opt/postgresql@17/bin/psql
